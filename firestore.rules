rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the document belongs to the authenticated user.
    // Also permits reading and claiming documents matching the user's email or legacy unassigned records.
    function isDocOwner() {
      return isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && (
          resource.data.userId == request.auth.uid ||
          (resource.data.userEmail != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email) ||
          (!('userId' in resource.data) && !('userEmail' in resource.data))
        ))
      );
    }

    function canWriteDoc() {
      return isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && (
          resource.data.userId == request.auth.uid ||
          (resource.data.userEmail != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email) ||
          (!('userId' in resource.data) && !('userEmail' in resource.data))
        ) && request.resource.data.userId == request.auth.uid)
      );
    }

    // Default deny for unauthenticated or unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles - partitioned strictly by UID
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Shop profiles - partitioned strictly by shop/user UID
    match /shops/{shopId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == shopId || resource == null);
    }

    // Mobiles Inventory - isolated per shop user
    match /mobiles/{docId} {
      allow read: if isDocOwner();
      allow write: if canWriteDoc();
    }

    // Sales Records - isolated per shop user
    match /sales/{docId} {
      allow read: if isDocOwner();
      allow write: if canWriteDoc();
    }

    // Bills & Invoices - isolated per shop user
    match /bills/{docId} {
      allow read: if isDocOwner();
      allow write: if canWriteDoc();
    }

    // Khata Customers - isolated per shop user
    match /khata/{docId} {
      allow read: if isDocOwner();
      allow write: if canWriteDoc();
    }

    // Khata Ledger Transactions - isolated per shop user
    match /khataTransactions/{docId} {
      allow read: if isDocOwner();
      allow write: if canWriteDoc();
    }

    // Expenses - isolated per shop user
    match /expenses/{docId} {
      allow read: if isDocOwner();
      allow write: if canWriteDoc();
    }

    // Backups - isolated per shop user
    match /backups/{docId} {
      allow read: if isDocOwner();
      allow write: if canWriteDoc();
    }

    // Daily Metrics
    match /dailyMetrics/{docId} {
      allow read: if isDocOwner();
      allow write: if canWriteDoc();
    }
  }
}
