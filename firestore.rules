rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Default deny for unauthenticated or unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Shop profile and configuration
    match /shops/{shopId} {
      allow read, write: if isAuthenticated();
    }

    // Mobiles Inventory
    match /mobiles/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Sales Records
    match /sales/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Bills & Invoices
    match /bills/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Khata Customers
    match /khata/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Khata Ledger Transactions
    match /khataTransactions/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Expenses
    match /expenses/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Backups
    match /backups/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Daily Metrics
    match /dailyMetrics/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Legacy or auxiliary credentials
    match /admin_credentials/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /shop_registrations/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
