{
  "entities": {
    "user": {
      "title": "User",
      "description": "Authenticated user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "shop": {
      "title": "Shop",
      "description": "Independent shop configuration and profile per shopkeeper",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "shortName": { "type": "string" },
        "ownerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "subTitle": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["shopName"]
    },
    "mobile": {
      "title": "Mobile Stock Item",
      "description": "Mobile phone stock unit belonging to a specific shopkeeper",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "modelName": { "type": "string" },
        "company": { "type": "string" },
        "ramRom": { "type": "string" },
        "basePrice": { "type": "number" },
        "quantity": { "type": "number" },
        "condition": { "type": "string" },
        "supplier": { "type": "string" },
        "imei1": { "type": "string" },
        "imei2": { "type": "string" }
      },
      "required": ["userId", "modelName", "quantity"]
    },
    "sale": {
      "title": "Sale Record",
      "description": "Sale transaction record scoped to a specific shopkeeper",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "itemType": { "type": "string" },
        "itemName": { "type": "string" },
        "basePrice": { "type": "number" },
        "sellPrice": { "type": "number" },
        "profit": { "type": "number" },
        "customerName": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["userId", "itemName", "sellPrice"]
    },
    "bill": {
      "title": "Bill",
      "description": "Invoice and receipt document scoped to a specific shopkeeper",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "billNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "totalSellPrice": { "type": "number" },
        "totalProfit": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["userId", "billNumber", "totalSellPrice"]
    },
    "khata": {
      "title": "Khata Customer",
      "description": "Customer ledger record owned by a specific shopkeeper",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "type": { "type": "string" },
        "totalBalance": { "type": "number" }
      },
      "required": ["userId", "name"]
    },
    "khataTransaction": {
      "title": "Khata Transaction",
      "description": "Debit or credit entry for a Khata customer",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "khataId": { "type": "string" },
        "customerName": { "type": "string" },
        "transactionType": { "type": "string" },
        "amount": { "type": "number" },
        "runningBalance": { "type": "number" }
      },
      "required": ["userId", "khataId", "amount", "transactionType"]
    },
    "expense": {
      "title": "Expense",
      "description": "Business expense entry owned by a specific shopkeeper",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["userId", "title", "amount"]
    },
    "backup": {
      "title": "Backup",
      "description": "Encrypted cloud backup snapshot for a specific shopkeeper",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles indexed by UID"
    },
    "/shops/{userId}": {
      "schema": "shop",
      "description": "Shop customization and profile indexed by UID"
    },
    "/mobiles/{docId}": {
      "schema": "mobile",
      "description": "Mobile inventory items partitioned by userId"
    },
    "/sales/{docId}": {
      "schema": "sale",
      "description": "Sales records partitioned by userId"
    },
    "/bills/{docId}": {
      "schema": "bill",
      "description": "Bills and receipts partitioned by userId"
    },
    "/khata/{docId}": {
      "schema": "khata",
      "description": "Khata customers partitioned by userId"
    },
    "/khataTransactions/{docId}": {
      "schema": "khataTransaction",
      "description": "Customer ledger transactions partitioned by userId"
    },
    "/expenses/{docId}": {
      "schema": "expense",
      "description": "Business expenses partitioned by userId"
    },
    "/backups/{docId}": {
      "schema": "backup",
      "description": "Shop backup snapshots partitioned by userId"
    }
  }
}
